# Phase 2.5B: Supabase Auth. VITE_-prefixed variables are inlined into the
# built browser bundle by Vite - only ever put the publishable (anon-scoped)
# key here, never the secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend origin. Empty/unset falls back to http://localhost:8000
# (the Docker Compose default port mapping) - see frontend/src/lib/api/client.ts.
VITE_API_BASE_URL=http://localhost:8000
