ENVIRONMENT=development

# Phase 2.5A: local|test|staging|production. staging/production require
# DATABASE_URL to be set explicitly below (the app refuses to start
# otherwise, rather than silently falling back to the Docker default).
APP_ENV=local

DB_HOST=postgres
DB_PORT=5432
DB_NAME=cybersec_assistant
DB_USER=cybersec
DB_PASSWORD=change-me

# Phase 2.5A: set these to point the app at Supabase Postgres instead of the
# Docker default above. Leave both empty for local development - the db_*
# values above are used instead.
#
# DATABASE_URL: the running application. Use Supabase's Session Pooler URI
#   (Project Settings -> Database -> Connection string -> Session pooler),
#   e.g. postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_MIGRATION_URL: Alembic and administrative scripts (seed/reset,
#   the data-migration tool). Use Supabase's direct connection if available,
#   since migrations run once per deploy and don't need pooling. Falls back
#   to DATABASE_URL if left empty.
# DATABASE_SSL_MODE: e.g. "require" for Supabase, empty/unset for local
#   Docker Postgres (which does not have TLS configured).
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_SSL_MODE=

# Phase 2.5B: the backend verifies Supabase Auth JWTs against this project.
# SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY are also what the frontend needs
# (as VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY - see
# frontend/.env.example). SUPABASE_SECRET_KEY is server-only: never prefix
# it VITE_, never commit it, never let it reach the frontend bundle, and
# never use it (or the publishable key) as a JWT-verification secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 2.5B: ONLY needed if this Supabase project still signs Auth tokens
# with the legacy symmetric HS256 secret (new projects use asymmetric
# RS256/ES256 keys and never need this - the backend verifies those against
# SUPABASE_URL's JWKS endpoint automatically, no secret required). This must
# be the dedicated JWT secret from Supabase's Auth settings - never the
# anon/publishable or service-role key above, neither of which is a valid
# HS256 verification secret.
SUPABASE_JWT_SECRET=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
SECRET_KEY=change-me

CORS_ORIGINS=http://localhost:3000

# Future optional integrations
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash  # optional override; defaults to a current
# stable generation model that supports generateContent - re-verify against
# https://generativelanguage.googleapis.com/v1beta/models if generation
# starts failing with a model-not-found/unsupported error, since Google
# retires older model ids over time.
VIRUSTOTAL_API_KEY=
NIST_NVD_API_KEY=
SUPER_ADMIN_IDS=

# Phase 2.6: Retrieval-Augmented Generation embeddings. Local (fastembed/
# ONNX, in-process) is the default and free-by-default provider - no
# document content ever leaves the process, and none of this needs to be
# set. The optional cloud provider (Gemini embeddings) activates ONLY when
# EMBEDDING_PROVIDER=gemini *and* GEMINI_API_KEY above is set - never from
# the key alone. EMBEDDING_DIMENSION is fixed into migration 0005's vector
# column at migration-authoring time; changing it for an existing
# deployment needs a new migration that resizes the column and re-embeds
# every stored chunk.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Phase 2.6: knowledge ingestion/retrieval tunables. Defaults work with an
# empty .env; RAG_SIMILARITY_THRESHOLD=0.20 is measured for the default
# local model, not guessed - see docs/RAG_ARCHITECTURE.md.
RAG_MAX_UPLOAD_BYTES=15000000
RAG_MAX_PAGES=300
RAG_MAX_CHUNKS_PER_DOCUMENT=2000
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_MIN_CHUNK_CHARS=40
RAG_RETRIEVAL_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
RAG_MAX_CONTEXT_CHARS=6000
RAG_ALLOW_GENERAL_KNOWLEDGE_FALLBACK=true

# Demo Mode (classroom/acceptance demo runs). DEMO_SEED_ENABLED seeds the
# four fixed demo accounts below on backend startup (idempotent - safe to
# leave on across restarts). DEMO_REQUIRE_GEMINI makes the AI capability
# only ever report ready=true after a real generateContent call has
# actually succeeded, never from a configured key alone. Both flags being
# set also auto-disables the anonymous zero-credential Local Mode session
# (POST /api/auth/local-session -> 404) unless ALLOW_LOCAL_MODE explicitly
# overrides that - see backend/config/settings.py::allow_local_mode.
# Passwords are intentionally not defaulted: set your own strong values,
# never commit them, never print them.
DEMO_SEED_ENABLED=true
DEMO_REQUIRE_GEMINI=true
DEMO_USER_PASSWORD=
DEMO_ANALYST_PASSWORD=
# demo_superadmin is the sole privileged demo account (role super_admin) -
# it carries every admin capability plus super_admin-only ones. demo_admin
# (role admin) is retired: no DEMO_ADMIN_PASSWORD var exists anymore, and a
# leftover demo_admin row from before this change is auto-disabled on
# startup (see backend/services/demo_accounts.py::_retire_demo_admin).
DEMO_SUPERADMIN_PASSWORD=
# demo_disabled reuses DEMO_USER_PASSWORD (see backend/services/demo_accounts.py)
# but the account is seeded inactive, so login for it always fails regardless.

# Explicit override for the anonymous, zero-credential Local Mode session.
# Leave unset in Demo Mode (the flags above already disable it). Set to
# true only for plain local development with no demo accounts seeded.
ALLOW_LOCAL_MODE=false
